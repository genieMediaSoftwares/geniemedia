# ============================================================================
#  Genie Media — Apache configuration for the Hostinger static deployment
#
#  Deploy this file to public_html/ alongside the contents of dist/. It lives in
#  Frontend/public/ so Vite copies it into dist/ on every build; editing the
#  copy on the server is a change the next deploy silently reverts.
#
#  Every directive is wrapped in <IfModule> so an unavailable module degrades
#  silently rather than returning a 500.
#
#  ORDER MATTERS in the rewrite section: the SPA fallback matches nearly every
#  request, so anything that needs to run must sit above it.
# ============================================================================


# ---------------------------------------------------------------------------
#  Redirects and SPA routing
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # -- Force HTTPS ----------------------------------------------------------
  # Both conditions are required. Behind Hostinger's proxy the connection to
  # Apache is plain HTTP, so %{HTTPS} is always off and the forwarded header is
  # what carries the truth. Testing %{HTTPS} alone gives an infinite loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # -- Canonical host: non-www ----------------------------------------------
  # The canonical tags, the sitemaps and every JSON-LD @id use the bare domain.
  # Answering on both hosts splits the ranking signals across two URLs that
  # search engines treat as separate pages.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # -- Retired blog slugs ---------------------------------------------------
  # BEGIN GENIE SLUG REDIRECTS
  # Generated from the blogs.slug_history column. Regenerate with:
  #   curl https://geniemedia.onrender.com/seo/redirects.htaccess
  # and replace everything between these two markers with the output.
  #
  # Apache cannot query MySQL, so these cannot be driven from the database at
  # request time. Where Node serves the site instead of Apache, the Express
  # route in Backend/routes/seoRoutes.js performs the same 301s live from
  # slug_history and this block is unnecessary.
  # END GENIE SLUG REDIRECTS

  # -- Generated SEO files --------------------------------------------------
  # sitemap.xml, blogs.xml, llms.txt and robots.txt are generated from the
  # database on the API host. seo-proxy.php fetches and caches them so they are
  # reachable under this domain, which is the only one crawlers ever visit.
  # A stale or static copy is served if the API is down — never a 500.
  RewriteRule ^(sitemap\.xml|pages\.xml|blogs\.xml|llms\.txt|robots\.txt)$ /seo-proxy.php [L]

  # -- Pre-rendered blog HTML for crawlers ----------------------------------
  # Bots only. They receive the document with the <head> and article text
  # already injected by the API, because most AI crawlers never execute the
  # JavaScript that would otherwise build the page. Humans fall through to the
  # SPA below and are not slowed down by the proxy hop.
  RewriteCond %{HTTP_USER_AGENT} (Googlebot|Bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot) [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} (GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-Web|anthropic-ai) [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} (PerplexityBot|Perplexity-User|Google-Extended|CCBot|Applebot|Amazonbot) [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} (cohere-ai|YouBot|DuckAssistBot|Meta-ExternalAgent|Bytespider) [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slackbot|Pinterest|embedly) [NC]
  RewriteRule ^blog/(.+)$ /seo-proxy.php [L]

  # -- Serve WebP where the browser accepts it ------------------------------
  # Uploads are already converted to WebP on the way in. This upgrades any
  # legacy .jpg/.png that happens to have a .webp sibling on disk. Vary: Accept
  # is set below so a cache cannot hand a WebP body to a client that asked for
  # JPEG.
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME} \.(jpe?g|png)$
  RewriteCond %{REQUEST_FILENAME}\.webp -f
  RewriteRule ^(.+)\.(jpe?g|png)$ $1.$2.webp [T=image/webp,E=WEBP_SERVED:1,L]

  # -- SPA routing ----------------------------------------------------------
  # Unchanged behaviour: anything that is not a real file or directory is served
  # index.html so React Router can handle the URL. This MUST stay last.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>


# ---------------------------------------------------------------------------
#  Compression
#
#  Brotli where the module exists, gzip everywhere else. Images and fonts are
#  deliberately excluded: WebP/JPEG/WOFF2 are already compressed, so running
#  them through DEFLATE costs CPU and gains nothing.
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/manifest+json
  AddOutputFilterByType BROTLI_COMPRESS application/ld+json
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
  AddOutputFilterByType DEFLATE application/ld+json
</IfModule>


# ---------------------------------------------------------------------------
#  Caching
#
#  Vite fingerprints everything it emits into /assets (index-Sf_VhKuD.js and
#  friends), so those filenames change whenever their contents change. They can
#  therefore be cached for a year and marked immutable — the browser will not
#  even send a revalidation request.
#
#  index.html must NOT be cached that way, or visitors keep loading a stale
#  build after a deploy. `max-age=0, must-revalidate` still lets the Hostinger
#  CDN hold a copy and answer with a cheap 304 against the ETag, which is what
#  fixes the "Document request latency" finding without risking stale HTML.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>

  # Fingerprinted build output — safe to cache forever.
  <FilesMatch "\.(js|mjs|css|woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images. Uploaded media is written with a unique timestamped filename, so
  # these are effectively immutable too.
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The HTML entry point — always revalidated.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Crawler files change rarely but must not go stale for a year. The sitemaps
  # are regenerated on every publish, so an hour is the longest they should be
  # allowed to lag.
  <FilesMatch "(robots\.txt|llms\.txt|.*\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Source maps are for debugging only — never cached hard, never indexed.
  <FilesMatch "\.map$">
    Header set Cache-Control "no-cache"
    Header set X-Robots-Tag "noindex"
  </FilesMatch>

  # A WebP substitution above makes the response depend on the Accept header.
  Header append Vary Accept env=WEBP_SERVED

  # Baseline security headers. These have no effect on layout or behaviour but
  # are part of the Best Practices audit.
  #
  # Deliberately NOT set here: a Content-Security-Policy, and Permissions-Policy
  # entries for microphone/camera. A CSP needs to be authored against the real
  # third-party origins (Google Analytics, Google Maps, YouTube) and tested, or
  # it silently breaks them. And this is a podcast/production business — blocking
  # mic and camera permissions would be an unpleasant surprise the day someone
  # adds a browser-based recorder.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=()"

</IfModule>

# mod_expires as a fallback for hosts where mod_headers is unavailable.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType application/xml         "access plus 1 hour"
  ExpiresByType text/plain              "access plus 1 hour"
</IfModule>


# ---------------------------------------------------------------------------
#  Correct MIME types — a few of these are missing on default Hostinger vhosts,
#  which makes the browser refuse the file or skip compression for it.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript          .js .mjs
  AddType image/webp                      .webp
  AddType image/avif                      .avif
  AddType font/woff2                      .woff2
  AddType application/manifest+json       .webmanifest
  AddType application/ld+json             .jsonld
</IfModule>


# ---------------------------------------------------------------------------
#  Crawler access
#
#  robots.txt is what grants or denies the AI crawlers, and it is served from
#  this directory as an ordinary static file. No user-agent blocking rule
#  belongs in here: a mod_rewrite block on GPTBot or ClaudeBot would remove the
#  site from AI answers entirely while robots.txt still claimed to welcome
#  them, and that contradiction takes months to notice.
# ---------------------------------------------------------------------------

# Directory listings expose the shape of the build for no benefit.
Options -Indexes
