DirectorySlash Off
Options -Indexes -MultiViews

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # BEGIN GENIE SLUG REDIRECTS
  # END GENIE SLUG REDIRECTS

  RewriteRule ^digital-marketing/?$ __SITE_URL__/digital_marketing [R=301,L]
  RewriteRule ^web-development/?$ __SITE_URL__/web_development [R=301,L]
  RewriteRule ^production-house/?$ __SITE_URL__/production_house [R=301,L]
  RewriteRule ^podcast-studio/?$ __SITE_URL__/podcast_studio [R=301,L]
  RewriteRule ^blog/?$ __SITE_URL__/blogs [R=301,L]
  RewriteRule ^admin/login/?$ __SITE_URL__/admin [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
  RewriteRule ^ __SITE_URL__/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?]
  RewriteRule ^ __SITE_URL__/%1 [R=301,L]

  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ __SITE_URL__/$1 [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ $1.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.txt$
  RewriteCond %{DOCUMENT_ROOT}/$1.html !-f
  RewriteRule ^(blog/.+)$ blog-view.html [L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=()"

  <If "%{REQUEST_URI} =~ m#^/admin(/|$)#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>

  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "(robots\.txt|llms\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
</IfModule>
