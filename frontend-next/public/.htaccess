# ============================================================================
#  Genie Media — Apache config for the Next.js static export on Hostinger
#
#  This file lives in frontend-next/public/ and is copied into dist/ by every
#  `npm run build`. Upload the CONTENTS of dist/ to public_html. Do not delete
#  the server-side files that are not part of the build: uploads/, upload.php
#  and contact.php must stay in public_html.
#
#  Next.js emits each page as <route>.html (about.html, blog/<cat>/<post>.html).
#  The rules below serve them at their clean URLs, so every URL is unchanged.
# ============================================================================

# /admin is both a page (admin.html) and a folder (admin/blogs.html). Without
# this, Apache would redirect /admin to /admin/ before the rules below run.
DirectorySlash Off
Options -Indexes -MultiViews

# The home page is index.html. Never fall back to Hostinger's default.php
# placeholder (or any other index file) for "/".
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # -- Force HTTPS (Hostinger proxies plain HTTP to Apache) -----------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # -- Canonical host: non-www ---------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # -- Live sitemap ----------------------------------------------------------
  # /sitemap.xml is generated by sitemap.php from the published posts in the
  # backend, so a new blog post is listed without a rebuild.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # -- Retired blog slugs (filled in by scripts/postbuild.mjs) --------------
  # BEGIN GENIE SLUG REDIRECTS
  # END GENIE SLUG REDIRECTS

  # -- Aliases and legacy URLs ---------------------------------------------
  RewriteRule ^digital-marketing/?$ __SITE_URL__/digital_marketing [R=301,L]
  RewriteRule ^web-development/?$ __SITE_URL__/web_development [R=301,L]
  RewriteRule ^production-house/?$ __SITE_URL__/production_house [R=301,L]
  RewriteRule ^podcast-studio/?$ __SITE_URL__/podcast_studio [R=301,L]
  RewriteRule ^blog/?$ __SITE_URL__/blogs [R=301,L]
  RewriteRule ^admin/login/?$ __SITE_URL__/admin [R=301,L]

  # A direct request for /page.html (or /index.html) 301s to the clean URL,
  # so only one address per page answers 200.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
  RewriteRule ^ __SITE_URL__/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?]
  RewriteRule ^ __SITE_URL__/%1 [R=301,L]

  # Trailing slash -> no trailing slash (canonicals never have one).
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ __SITE_URL__/$1 [R=301,L]

  # -- Clean URLs: /about -> about.html ------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # -- Blog posts published after the last build --------------------------
  # No pre-built .html exists yet, so serve the live fallback page at the
  # post's own URL; it loads the post from the API. (Data .txt requests are
  # excluded so they 404 cleanly.) Rebuild to give the post a static page.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.txt$
  RewriteCond %{DOCUMENT_ROOT}/$1.html !-f
  RewriteRule ^(blog/.+)$ blog-view.html [L]
</IfModule>

# Anything that matched no file is a real 404 (never the home page with a 200,
# which is what Search Console flagged as a soft 404).
ErrorDocument 404 /404.html


# ---------------------------------------------------------------------------
#  Headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=()"

  # Admin screens are never indexed, even if a link to them leaks.
  <If "%{REQUEST_URI} =~ m#^/admin(/|$)#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>

  # Next.js fingerprints everything under /_next/static: cache it for a year.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML is revalidated on every visit, so a new deploy is seen immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "(robots\.txt|llms\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>


# ---------------------------------------------------------------------------
#  Compression and MIME types
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
</IfModule>
