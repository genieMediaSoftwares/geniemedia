# Public base URL of the existing Express backend (no trailing slash).
# Used by the browser (admin panel, client fetches) and by the Next.js server
# (ISR fetches for blogs and projects).
NEXT_PUBLIC_API_BASE_URL=https://geniemedia-81qf.onrender.com

# Public origin of this site. Canonicals, sitemap and JSON-LD are built from it.
NEXT_PUBLIC_SITE_URL=https://geniemedia.in

# Optional: server-only override for the API base when the Next.js server can
# reach the backend on a private/faster address. Never exposed to the browser.
# API_INTERNAL_BASE_URL=

# Where Hostinger's /uploads/ folder is reachable once geniemedia.in points at
# Vercel (a subdomain such as files.geniemedia.in on the Hostinger account).
# Existing image URLs https://geniemedia.in/uploads/... are proxied there.
# UPLOADS_ORIGIN=https://files.geniemedia.in
